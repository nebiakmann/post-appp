# POS Sistemi Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin

# Veritabanı Ayarları
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_app
DB_USER=root
DB_PASS=

# Sistem Ayarları
SITE_NAME=Restoran POS
SITE_URL=http://localhost/pos-app/
TIMEZONE=Europe/Istanbul

# Varsayılan Değerler
DEFAULT_TAX_RATE=8.0
DEFAULT_SERVICE_RATE=0.0
DEFAULT_CURRENCY=₺
DEFAULT_LANGUAGE=tr

# Güvenlik Ayarları
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=6

# E-posta Ayarları (Gelecekte kullanım için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@restoran.com
SMTP_FROM_NAME=Restoran POS

# Debug Ayarları
DEBUG_MODE=false
LOG_ERRORS=true
SHOW_ERRORS=false

